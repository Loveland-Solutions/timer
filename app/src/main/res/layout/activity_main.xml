<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/main_heading" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:text="@string/main_intro" />

        <!-- Shown only while something needs fixing -->
        <LinearLayout
            android:id="@+id/cardSetup"
            style="@style/Card">

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_setup" />

            <LinearLayout
                android:id="@+id/rowNotif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Warning"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/check_notif_missing" />

                <Button
                    android:id="@+id/btnNotif"
                    style="@style/Btn.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/btn_fix" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowAlarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Warning"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/check_alarm_missing" />

                <Button
                    android:id="@+id/btnAlarm"
                    style="@style/Btn.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/btn_fix" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowFsi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Warning"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/check_fsi_missing" />

                <Button
                    android:id="@+id/btnFsi"
                    style="@style/Btn.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/btn_fix" />
            </LinearLayout>

        </LinearLayout>

        <!-- The tiles -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_count" />

                <Button
                    android:id="@+id/btnFewer"
                    style="@style/Btn.Step"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/desc_fewer"
                    android:text="@string/btn_fewer" />

                <TextView
                    android:id="@+id/tvTileCount"
                    style="@style/Text.Section"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="center" />

                <Button
                    android:id="@+id/btnMore"
                    style="@style/Btn.Step"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/desc_more"
                    android:text="@string/btn_more" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/durationRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <Switch
                android:id="@+id/cbCustom"
                style="@style/Text.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/check_custom" />
        </LinearLayout>

        <!-- Quick Settings -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_tiles" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tiles_help" />

            <Button
                android:id="@+id/btnAddTiles"
                style="@style/Btn.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/btn_add_tiles" />
        </LinearLayout>

        <!-- Alarm -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_alarm" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/main_footer" />

            <Button
                android:id="@+id/btnTest"
                style="@style/Btn.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/btn_test" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/check_battery" />

            <Button
                android:id="@+id/btnBattery"
                style="@style/Btn.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_app_info" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAbout"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnPrivacy"
            style="@style/Btn.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_privacy" />

    </LinearLayout>
</ScrollView>
