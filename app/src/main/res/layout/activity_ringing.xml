<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/tvRingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ring_title"
        android:textColor="@color/ring_fg"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRingSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/ring_fg_dim"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="64dp"
        android:backgroundTint="@color/ring_stop"
        android:text="@string/action_stop"
        android:textColor="@color/ring_fg"
        android:textSize="32sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnPlusOne"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/ring_plus"
        android:text="@string/action_plus_one"
        android:textColor="@color/ring_fg"
        android:textSize="22sp" />

</LinearLayout>
