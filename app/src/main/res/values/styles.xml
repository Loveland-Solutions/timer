<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlActivated">@color/primary</item>
    </style>

    <style name="RingTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/lock_bg</item>
        <item name="android:colorAccent">@color/lock_primary</item>
    </style>

    <style name="Btn" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Btn.Filled" parent="Btn">
        <item name="android:background">@drawable/bg_filled</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <style name="Btn.Text" parent="Btn">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Btn.Tonal" parent="Btn">
        <item name="android:background">@drawable/bg_tonal</item>
        <item name="android:textColor">@color/on_tonal</item>
    </style>

    <style name="Btn.Step" parent="Btn">
        <item name="android:background">@drawable/bg_tonal</item>
        <item name="android:textColor">@color/on_tonal</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Btn.Chip" parent="Btn">
        <item name="android:background">@drawable/bg_lock_tonal</item>
        <item name="android:textColor">@color/on_lock_tonal</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Btn.LockText" parent="Btn">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/lock_dim</item>
    </style>

    <style name="Btn.LockPrimary" parent="Btn">
        <item name="android:background">@drawable/bg_lock_primary</item>
        <item name="android:textColor">@color/on_lock_primary</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Btn.Stop" parent="Btn">
        <item name="android:background">@drawable/bg_stop</item>
        <item name="android:textColor">@color/lock_fg</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="Btn.LockTonal" parent="Btn">
        <item name="android:background">@drawable/bg_lock_tonal</item>
        <item name="android:textColor">@color/on_lock_tonal</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Text" />

    <style name="Text.Title">
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Section">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Text.Row">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Text.Warning">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/warning</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Field">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:inputType">number</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textColorHint">@color/on_surface_variant</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
    </style>
</resources>
